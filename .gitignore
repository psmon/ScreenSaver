## .NET / Visual Studio gitignore

# Build output
bin/
obj/
out/
[Dd]ebug/
[Rr]elease/
x64/
x86/
[Ww][Ii][Nn]32/
[Aa][Rr][Mm]/
[Aa][Rr][Mm]64/
build/
bld/
[Bb]in/
[Oo]bj/
[Ll]og/
[Ll]ogs/

# Visual Studio / Rider / VS Code
.vs/
.vscode/
.idea/
*.suo
*.user
*.userosscache
*.sln.docstates
*.userprefs
*.DotSettings.user

# Build results / artifacts
*.dll
*.exe
*.pdb
*.cache
*.publishsettings
publish/
PublishProfiles/

# NuGet
*.nupkg
*.snupkg
.nuget/
packages/
!packages/build/
project.lock.json
project.fragment.lock.json
artifacts/

# Test / coverage
[Tt]est[Rr]esult*/
[Bb]uild[Ll]og.*
*.trx
*.coverage
*.coveragexml
coverage*.json
coverage*.xml
TestResults/

# MSBuild / Roslyn temp
*.tmp
*.tmp_proj
*_wpftmp.csproj
*.binlog

# Rider
*.sln.iml

# Python (sprite-animator skill scripts)
__pycache__/
*.pyc
*.pyo

# OS files
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
.DS_Store

# App-local scratch
_*.png
*.local.json

# Secrets — real API keys never get committed; only the .tmp templates do
.secret/*.json
# ...but DO keep the secret templates (the broad *.tmp rule above would hide them)
!.secret/*.json.tmp

# Generated sprite intermediates (concept art / raw frames are large)
image/
design/sprite/
